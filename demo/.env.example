# NeuroTCS demo — data path configuration (App Service "Application settings").
#
# Copy to a real .env for LOCAL dev, or set these as App Service Application
# Settings in Azure. NEVER commit a real .env (it is gitignored). These point at
# the DUA files ALREADY on the private server; the demo only ever reads them.
#
# The same env var names the shipped tests/audit_core/test_real_*_audit.py read,
# so the web reproduces the CLI invariants against the identical files.

# A4/LEARN — the Raw Data CDR export
NEUROTCS_A4_CDR=/data/A4Learn/Raw Data/cdr.csv

# NACC — investigator data freeze CSV
NEUROTCS_NACC_CSV=/data/nacc/investigator_nacc73.csv

# OASIS-3 — UDS B4 CDR CSV (NEUROTCS_OASIS3_UDSB4 accepted as a legacy alias)
NEUROTCS_OASIS3_CDR=/data/oasis3/OASIS3_UDSb4_cdr.csv

# ADNI — ADNIMERGE2 R-package DXSUM.rda
NEUROTCS_ADNI_DXSUM_RDA=/data/adni/ADNIMERGE2/data/DXSUM.rda

# MIRIAD — DIRECTORY holding the 3 XNAT CSVs (clinical + sessions + subjects)
NEUROTCS_MIRIAD_DIR=/data/miriad

# Optional web tuning (see demo/startup.sh)
# WEB_WORKERS=1
# WEB_THREADS=4
# WEB_TIMEOUT=600
